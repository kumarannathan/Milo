# Copy to .env to change how Milo runs. Every setting is optional.
# API keys are not set here: add them on the Connections screen.

# Port and address the server listens on.
MILO_PORT=4400
MILO_HOST=127.0.0.1

# Where the workspace file (data/milo.json) is stored.
MILO_DATA_DIR=data

# Require a password (HTTP basic auth, any username) for every request.
# Set this before exposing Milo beyond localhost.
# MILO_PASSWORD=

# Copy to .env to change how Milo runs. Every setting is optional.
# API keys are not set here: each user adds them on the Connections screen.

# Port and address the server listens on.
MILO_PORT=4400
MILO_HOST=127.0.0.1

# Public URL when hosted (turns on Secure cookies for https).
# MILO_PUBLIC_URL=https://app.example.com

# Accounts: local (email + password stored in data/users.json, default), supabase, or none (single user, no sign-in).
MILO_AUTH=local
# Signs session cookies for MILO_AUTH=local. Generated and stored in data/.session-secret when unset.
# MILO_SESSION_SECRET=

# For MILO_AUTH=supabase.
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_JWT_SECRET=

# Where workspaces are stored. Each user gets data/tenants/<id>/milo.json.
MILO_DATA_DIR=data

# Playbooks offered. The product ships sales only; add markets to enable prediction markets.
MILO_PLAYBOOKS=sales

# Optional extra lock in front of everything (HTTP basic auth, any username).
# MILO_PASSWORD=

# Set to 1 to drop the per-request log line.
# MILO_QUIET=
